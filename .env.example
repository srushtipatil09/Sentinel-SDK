# DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres"
# Transaction Pooler URI (Recommended for High Concurrency):
# DATABASE_URL="postgresql+asyncpg://postgres.xxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:@db.cnfehxcjkfebbsittymb.supabase.co:5432/postgres"

