# ─── Core App Environment ────────────────────────────────────────
APP_NAME="Sentinel AI Platform"
APP_ENV="development"
DEBUG=true
SECRET_KEY="super-secret-production-key-change-in-env-32bytes"

# ─── Server Configuration ────────────────────────────────────────
HOST="0.0.0.0"
PORT=8080

# ─── Supabase PostgreSQL Cloud Configuration ─────────────────────
# Direct Connection URI:
# DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres"
# Transaction Pooler URI (Recommended for High Concurrency):
# DATABASE_URL="postgresql+asyncpg://postgres.xxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres:@db.cnfehxcjkfebbsittymb.supabase.co:5432/postgres"

# ─── Vector Database (ChromaDB) ──────────────────────────────────
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000
CHROMADB_PATH="./data/chromadb"
CHROMADB_PERSIST_DIRECTORY="./data/chromadb"

# ─── Redis Cache ─────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379


# ─── AI & LLM ────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-2.5-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# ─── Google Cloud Platform ───────────────────────────────────────
GCP_PROJECT_ID=""
GCP_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS=""

# BigQuery (telemetry warehouse + BigQuery ML)
BIGQUERY_ENABLED=true
BIGQUERY_DATASET="sentinelai"
BIGQUERY_TELEMETRY_TABLE="telemetry_events"
BIGQUERY_ANOMALY_MODEL="error_rate_arima"

# Pub/Sub (async event bus)
PUBSUB_ENABLED=true
PUBSUB_TELEMETRY_TOPIC="telemetry-events"
PUBSUB_INCIDENT_TOPIC="incident-events"
PUBSUB_RCA_TOPIC="ai-rca-events"

# Firestore (live incident state mirror)
FIRESTORE_ENABLED=true
FIRESTORE_INCIDENTS_COLLECTION="incidents_live"

# Vertex AI (managed embeddings — 768-dim; requires ChromaDB re-index)
VERTEX_AI_ENABLED=true
VERTEX_EMBEDDING_MODEL="text-embedding-004"
